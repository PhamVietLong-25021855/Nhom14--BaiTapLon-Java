<?xml version="1.0" encoding="UTF-8"?>

<!-- File note: Bố cục dialog nạp tiền vào ví. -->
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
           prefHeight="380.0" prefWidth="480.0"
           fx:controller="userauth.gui.fxml.TopUpDialogController"
           styleClass="dialog-root"
           stylesheets="@auth-theme.css"
           xmlns="http://javafx.com/javafx/25"
           xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <VBox maxWidth="436.0" prefWidth="436.0" spacing="16.0" styleClass="dialog-card">
            <children>
                <Label styleClass="section-title" text="TOP UP WALLET" />
                <Label fx:id="lblUsername" styleClass="body-text" text="Account: -" />
                <VBox spacing="10.0">
                    <children>
                        <Label styleClass="field-label" text="Amount" />
                        <TextField fx:id="txtAmount" promptText="Enter amount to top up" />
                        <Label styleClass="field-label" text="Payment Method" />
                        <ComboBox fx:id="cbPaymentMethod" prefWidth="200.0" />
                    </children>
                </VBox>
                <Label fx:id="lblError" managed="false" styleClass="error-text" text="Error message" visible="false" wrapText="true" />
                <HBox spacing="10.0" styleClass="dialog-actions">
                    <children>
                        <Button mnemonicParsing="false" onAction="#handleCancel" styleClass="button ghost-button" text="CANCEL" />
                        <Button mnemonicParsing="false" onAction="#handleSubmit" styleClass="button primary-button" text="CREATE REQUEST" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</StackPane>

