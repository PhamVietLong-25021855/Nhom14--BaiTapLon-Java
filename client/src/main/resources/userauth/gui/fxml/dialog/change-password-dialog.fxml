<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
           prefHeight="620.0" prefWidth="760.0"
           fx:controller="userauth.gui.fxml.dialog.ChangePasswordDialogController"
           styleClass="dialog-root"
           stylesheets="@../shared/auth-theme.css"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <VBox maxWidth="680.0" prefWidth="680.0" spacing="20.0" styleClass="dialog-card dialog-pro">
            <children>
                <VBox spacing="6.0">
                    <children>
                        <Label text="SECURITY SETTINGS" styleClass="dialog-kicker"/>
                        <Label text="Change Password" styleClass="section-title dialog-title"/>
                        <Label text="Update your password to keep your account secure. Use a strong password with both letters and numbers." wrapText="true" styleClass="secondary-text dialog-subtitle"/>
                    </children>
                </VBox>

                <VBox spacing="4.0" styleClass="dialog-inline-info">
                    <children>
                        <Label text="Account" styleClass="caption-text"/>
                        <Label fx:id="lblUsername" text="Account: -" styleClass="body-text dialog-account"/>
                    </children>
                </VBox>

                <VBox spacing="12.0">
                    <children>
                        <Label text="Current Password" styleClass="field-label"/>
                        <PasswordField fx:id="txtOldPassword" promptText="Enter current password"/>
                        <Label text="New Password" styleClass="field-label"/>
                        <PasswordField fx:id="txtNewPassword" promptText="At least 6 characters, include letters and numbers"/>
                        <Label text="Confirm New Password" styleClass="field-label"/>
                        <PasswordField fx:id="txtConfirmPassword" onAction="#handleSubmit" promptText="Re-enter your new password"/>
                    </children>
                </VBox>

                <Label fx:id="lblError" managed="false" text="Error message" visible="false" wrapText="true" styleClass="error-text dialog-error"/>
                <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="dialog-actions">
                    <children>
                        <Label text="Password changes take effect immediately." styleClass="caption-text"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button mnemonicParsing="false" onAction="#handleCancel" text="Cancel" styleClass="button ghost-button dialog-action-secondary"/>
                        <Button mnemonicParsing="false" onAction="#handleSubmit" text="Update Password" styleClass="button primary-button dialog-action-primary"/>
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</StackPane>
