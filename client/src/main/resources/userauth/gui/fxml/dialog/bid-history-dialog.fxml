<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="-Infinity" minWidth="-Infinity" prefHeight="720.0" prefWidth="720.0" styleClass="dialog-root" stylesheets="@../shared/auth-theme.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="userauth.gui.fxml.dialog.BidHistoryDialogController">
    <children>
        <VBox maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="700.0" prefWidth="700.0" spacing="14.0" styleClass="dialog-card">
            <children>
                <Label styleClass="section-title" text="BID HISTORY" />
                <Label fx:id="lblBidderName" styleClass="body-text" text="Bidder: -" wrapText="true" />
                <Label fx:id="lblSummary" styleClass="secondary-text" text="Total transactions: 0 | Won products: 0" />

                <VBox spacing="8.0" VBox.vgrow="ALWAYS">
                    <children>
                        <Label styleClass="panel-title" text="Transaction History" />
                        <TableView fx:id="tableTransactions" prefHeight="240.0" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colTransactionTime" prefWidth="150.0" text="Time" />
                                <TableColumn fx:id="colTransactionProduct" prefWidth="230.0" text="Product" />
                                <TableColumn fx:id="colTransactionCategory" prefWidth="145.0" text="Category" />
                                <TableColumn fx:id="colTransactionAmount" prefWidth="145.0" text="Bid Amount" />
                                <TableColumn fx:id="colTransactionStatus" prefWidth="120.0" text="Status" />
                                <TableColumn fx:id="colTransactionResult" prefWidth="150.0" text="Result" />
                            </columns>
                        </TableView>
                    </children>
                </VBox>

                <VBox spacing="8.0" VBox.vgrow="ALWAYS">
                    <children>
                        <Label styleClass="panel-title" text="Won Products" />
                        <TableView fx:id="tableWonProducts" prefHeight="240.0" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colWonProduct" prefWidth="285.0" text="Product" />
                                <TableColumn fx:id="colWonCategory" prefWidth="180.0" text="Category" />
                                <TableColumn fx:id="colWonPrice" prefWidth="170.0" text="Winning Price" />
                                <TableColumn fx:id="colWonStatus" prefWidth="135.0" text="Status" />
                                <TableColumn fx:id="colWonEndedAt" prefWidth="170.0" text="Ended At" />
                            </columns>
                        </TableView>
                    </children>
                </VBox>

                <HBox spacing="10.0" styleClass="dialog-actions">
                    <children>
                        <Region HBox.hgrow="ALWAYS" />
                        <Button mnemonicParsing="false" onAction="#handleClose" styleClass="button primary-button" text="CLOSE" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</StackPane>
