<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Links back to your root project configuration -->
    <parent>
        <groupId>com.baitaplon</groupId>
        <artifactId>auction-house</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>client</artifactId>
    <name>auction-house-client</name>

    <dependencies>
        <!-- Shared backend/frontend data models and utilities -->
        <dependency>
            <groupId>com.baitaplon</groupId>
            <artifactId>core-common</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- UI Dependencies (Versions are managed by the parent POM) -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>${javafx.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Plugin to run the JavaFX GUI application directly -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>userauth.ClientLauncher</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>