<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane maxHeight="Infinity" maxWidth="Infinity"
           prefHeight="940.0" prefWidth="1440.0"
           fx:controller="userauth.gui.fxml.AdminHomepageViewController"
           styleClass="page-root dashboard-root"
           stylesheets="@auth-theme.css"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <VBox maxHeight="Infinity" maxWidth="Infinity" spacing="18.0" styleClass="shell-frame">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="topbar-surface">
                    <children>
                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Homepage Content Manager" styleClass="topbar-title"/>
                                <Label text="Create, preview, and publish homepage announcements from one workspace." styleClass="topbar-subtitle"/>
                            </children>
                        </VBox>
                        <VBox spacing="2.0" styleClass="user-pill">
                            <children>
                                <Label fx:id="lblCmsAdminName" text="Admin" styleClass="user-name"/>
                                <Label text="Role: ADMIN" styleClass="user-role"/>
                            </children>
                        </VBox>
                        <MenuButton mnemonicParsing="false" styleClass="button settings-menu-button" text="SETTINGS">
                            <items>
                                <MenuItem mnemonicParsing="false" onAction="#handleSwitchToEnglish" text="English"/>
                                <MenuItem mnemonicParsing="false" onAction="#handleSwitchToVietnamese" text="Vietnamese"/>
                                <SeparatorMenuItem/>
                                <MenuItem mnemonicParsing="false" onAction="#handleLogout" text="LOG OUT"/>
                            </items>
                        </MenuButton>
                    </children>
                </HBox>
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="dashboard-scroll" VBox.vgrow="ALWAYS">
                    <content>
                        <VBox spacing="18.0">
                            <children>
                                <VBox spacing="12.0" styleClass="hero-banner hero-banner-dark">
                                    <children>
                                        <Label text="HOMEPAGE OPERATIONS" styleClass="dashboard-eyebrow"/>
                                        <Label text="Manage homepage announcements and linked auctions from one admin screen."
                                               wrapText="true"
                                               styleClass="dashboard-title"/>
                                        <Label text="Draft content, bind it to auctions, and review the live preview before publishing."
                                               wrapText="true"
                                               styleClass="dashboard-copy"/>
                                    </children>
                                </VBox>
                                <HBox spacing="12.0">
                                    <children>
                                        <VBox spacing="8.0" prefWidth="0.0" styleClass="metric-card" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label text="TOTAL ANNOUNCEMENTS" styleClass="metric-label"/>
                                                <Label fx:id="lblAnnouncementCount" text="0" styleClass="metric-value"/>
                                            </children>
                                        </VBox>
                                        <VBox spacing="8.0" prefWidth="0.0" styleClass="metric-card" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label text="LINKED AUCTIONS" styleClass="metric-label"/>
                                                <Label fx:id="lblLinkedCount" text="0" styleClass="metric-value"/>
                                            </children>
                                        </VBox>
                                        <VBox spacing="8.0" prefWidth="0.0" styleClass="metric-card" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label text="VISIBLE AUCTIONS" styleClass="metric-label"/>
                                                <Label fx:id="lblUpcomingCount" text="0" styleClass="metric-value"/>
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>
                                <HBox alignment="TOP_LEFT" spacing="18.0">
                                    <children>
                                        <VBox HBox.hgrow="ALWAYS" spacing="16.0">
                                            <children>
                                                <VBox spacing="14.0" styleClass="panel-card">
                                                    <children>
                                                        <VBox spacing="4.0">
                                                            <children>
                                                                <Label text="CREATE / EDIT HOMEPAGE ANNOUNCEMENT" styleClass="panel-title"/>
                                                                <Label text="Use this form to publish new homepage content or update an existing announcement." wrapText="true" styleClass="panel-copy"/>
                                                            </children>
                                                        </VBox>
                                                        <TextField fx:id="txtAnnouncementTitle" promptText="Announcement Title"/>
                                                        <TextField fx:id="txtAnnouncementSchedule" promptText="Auction schedule information shown on the homepage"/>
                                                        <ComboBox fx:id="cbLinkedAuction" prefWidth="420.0"/>
                                                        <TextArea fx:id="txtAnnouncementSummary" prefHeight="110.0" promptText="Short summary displayed on the homepage" wrapText="true"/>
                                                        <TextArea fx:id="txtAnnouncementDetails" prefHeight="160.0" promptText="Additional details, notes, instructions..." wrapText="true"/>
                                                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                                                            <children>
                                                                <Button fx:id="btnSaveAnnouncement" mnemonicParsing="false" onAction="#handleSaveAnnouncement" text="PUBLISH TO HOMEPAGE" styleClass="button primary-button"/>
                                                                <Button mnemonicParsing="false" onAction="#handleUseSelectedAuctionSchedule" text="USE AUCTION SCHEDULE" styleClass="button success-button"/>
                                                                <Button mnemonicParsing="false" onAction="#handleClearForm" text="CLEAR FORM" styleClass="button ghost-button"/>
                                                            </children>
                                                        </HBox>
                                                    </children>
                                                </VBox>
                                                <VBox spacing="14.0" styleClass="panel-card">
                                                    <children>
                                                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                                                            <children>
                                                                <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                                                    <children>
                                                                        <Label text="CURRENT ANNOUNCEMENTS" styleClass="panel-title"/>
                                                                        <Label text="Select an item to edit or remove published homepage content." wrapText="true" styleClass="panel-copy"/>
                                                                    </children>
                                                                </VBox>
                                                                <Button mnemonicParsing="false" onAction="#handleRefreshData" text="REFRESH" styleClass="button ghost-button"/>
                                                                <Button mnemonicParsing="false" onAction="#handleEditSelectedAnnouncement" text="EDIT" styleClass="button success-button"/>
                                                                <Button mnemonicParsing="false" onAction="#handleDeleteSelectedAnnouncement" text="DELETE" styleClass="button danger-button"/>
                                                            </children>
                                                        </HBox>
                                                        <TableView fx:id="tableAnnouncements" prefHeight="330.0" VBox.vgrow="ALWAYS">
                                                            <columns>
                                                                <TableColumn fx:id="colAnnouncementId" prefWidth="70.0" text="ID"/>
                                                                <TableColumn fx:id="colAnnouncementTitle" prefWidth="250.0" text="Title"/>
                                                                <TableColumn fx:id="colAnnouncementAuction" prefWidth="190.0" text="Linked Auction"/>
                                                                <TableColumn fx:id="colAnnouncementSchedule" prefWidth="270.0" text="Display Schedule"/>
                                                                <TableColumn fx:id="colAnnouncementUpdatedAt" prefWidth="170.0" text="Updated"/>
                                                            </columns>
                                                        </TableView>
                                                    </children>
                                                </VBox>
                                            </children>
                                        </VBox>
                                        <VBox prefWidth="390.0" spacing="16.0">
                                            <children>
                                                <VBox spacing="12.0" styleClass="preview-card">
                                                    <children>
                                                        <Label text="LIVE PREVIEW" styleClass="detail-kicker"/>
                                                        <Label fx:id="lblPreviewTitle" text="Announcement Title" wrapText="true" styleClass="preview-name"/>
                                                        <Label fx:id="lblPreviewSummary" text="A short summary will appear here." wrapText="true" styleClass="preview-copy"/>
                                                        <VBox spacing="4.0" styleClass="detail-meta-box">
                                                            <children>
                                                                <Label text="DISPLAY SCHEDULE" styleClass="detail-meta-label"/>
                                                                <Label fx:id="lblPreviewSchedule" text="-" wrapText="true" styleClass="detail-meta-value"/>
                                                            </children>
                                                        </VBox>
                                                        <VBox spacing="4.0" styleClass="detail-meta-box">
                                                            <children>
                                                                <Label text="LINKED AUCTION" styleClass="detail-meta-label"/>
                                                                <Label fx:id="lblPreviewLinkedAuction" text="Not linked" wrapText="true" styleClass="detail-meta-value"/>
                                                            </children>
                                                        </VBox>
                                                        <VBox spacing="4.0" styleClass="detail-meta-box">
                                                            <children>
                                                                <Label text="DETAILS" styleClass="detail-meta-label"/>
                                                                <Label fx:id="lblPreviewDetails" text="Additional details and instructions will appear here." wrapText="true" styleClass="detail-meta-value"/>
                                                            </children>
                                                        </VBox>
                                                    </children>
                                                </VBox>
                                                <VBox spacing="14.0" styleClass="panel-card">
                                                    <children>
                                                        <VBox spacing="4.0">
                                                            <children>
                                                                <Label text="AUCTIONS READY FOR HOMEPAGE" styleClass="panel-title"/>
                                                                <Label text="Choose an auction here, then pull its schedule into the announcement form." wrapText="true" styleClass="panel-copy"/>
                                                            </children>
                                                        </VBox>
                                                        <TableView fx:id="tableUpcomingAuctions" prefHeight="290.0">
                                                            <columns>
                                                                <TableColumn fx:id="colUpcomingId" prefWidth="70.0" text="ID"/>
                                                                <TableColumn fx:id="colUpcomingName" prefWidth="170.0" text="Product Name"/>
                                                                <TableColumn fx:id="colUpcomingSchedule" prefWidth="230.0" text="Time Window"/>
                                                                <TableColumn fx:id="colUpcomingStatus" prefWidth="110.0" text="Status"/>
                                                            </columns>
                                                        </TableView>
                                                    </children>
                                                </VBox>
                                                <VBox spacing="12.0" styleClass="panel-card">
                                                    <children>
                                                        <Label text="NAVIGATION" styleClass="panel-title"/>
                                                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                                                            <children>
                                                                <Button mnemonicParsing="false" onAction="#handleBackToDashboard" text="BACK TO DASHBOARD" styleClass="button success-button"/>
                                                                <Button mnemonicParsing="false" onAction="#handleChangePassword" text="CHANGE PASSWORD" styleClass="button ghost-button"/>
                                                            </children>
                                                        </HBox>
                                                    </children>
                                                </VBox>
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </content>
                </ScrollPane>
            </children>
        </VBox>
    </children>
</StackPane>
